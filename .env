# Environment configuration for MCP_DATA.
# These mirror the defaults baked into src/mcp_data/config.py. Adjust as needed;
# anything left unset here falls back to those same code defaults.

# Transport for the MCP server/client: "stdio" or "http".
MCP_TRANSPORT=stdio

# Database backend type: "sqlite" or "duckdb".
MCP_DB_TYPE=sqlite

# Path to the database file (matches the backend type).
# For SQLite: path/to/file.db or path/to/file.sqlite
# For DuckDB: path/to/file.duckdb
MCP_DB_PATH=C:/data/sqlitedb/input_data.db

# To use DuckDB instead, uncomment:
# MCP_DB_TYPE=duckdb
# MCP_DB_PATH=C:/data/duckdb/input_data.duckdb

LOCALDATA_PAR_FOLDER = "par_curve"
LOCALDATA_ZERO_COUPON_FOLDER = "zero_coupon"
LOCALDATA_SPOT_FX_FOLDER = "spot_fx_rates"

DERIVED_LOCALDATA_PATH = "D:/data/derived"
DERIVED_CORR_FOLDER = "corr"

# Host and port used by the Streamable HTTP transport.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Request timeout in seconds (HTTP transport only).
MCP_TIMEOUT=40

# Display name reported by the MCP server.
MCP_SERVER_NAME=db-mcp

# Anthropic API key — required when using the LLM planner (--llm flag).
# ANTHROPIC_API_KEY=sk-ant-...

# Disable LangSmith tracing (enabled by default in LangChain; fails without a
# LangSmith API key and produces noisy 403 errors in the background).
LANGCHAIN_TRACING_V2=false
